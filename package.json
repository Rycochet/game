{
    "name": "game",
    "version": "0.0.1",
    "description": "Proof of concept game",
    "scripts": {
        "build": "vite build",
        "build:preview": "vite preview",
        "clean": "rm -rf ./dist/**",
        "format": "npm-run-all format:*",
        "format:prettier": "prettier --write src",
        "lint": "npm-run-all lint:*",
        "lint:prettier": "prettier --check src",
        "lint:tsc": "tsc --noEmit --noUnusedLocals --noUnusedParameters --skipLibCheck",
        "start": "vite",
        "test": "vitest run",
        "test:coverage": "vitest --coverage",
        "test:watch": "vitest watch"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Rycochet/game.git"
    },
    "authors": [
        "Ryc O'Chet <rycochet@rycochet.com>"
    ],
    "bugs": {
        "url": "https://github.com/Rycochet/game/issues"
    },
    "homepage": "https://github.com/Rycochet/game",
    "dependencies": {
        "classnames": "2.5.1",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "simplex-noise": "4.0.3"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "4.4.1",
        "@small-tech/vite-plugin-sri": "1.0.1",
        "@testing-library/react": "16.2.0",
        "@types/node": "22.10.7",
        "@types/react": "19.0.7",
        "@types/react-dom": "19.0.3",
        "@vitejs/plugin-react": "4.3.4",
        "assemblyscript": "0.27.31",
        "lightningcss": "1.29.1",
        "npm-run-all": "4.1.5",
        "prettier": "3.4.2",
        "tiny-invariant": "1.3.3",
        "typescript": "5.7.3",
        "vite": "6.0.10",
        "vite-plugin-compression2": "1.3.3",
        "vite-plugin-simple-html": "0.2.0",
        "vite-tsconfig-paths": "5.1.4",
        "vitest": "3.0.2"
    }
}
