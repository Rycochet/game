{
    "name": "game",
    "version": "0.0.1",
    "description": "Proof of concept game",
    "scripts": {
        "build": "vite build",
        "build:preview": "vite preview",
        "clean": "rm -rf ./dist/**",
        "format": "npm-run-all format:*",
        "format:prettier": "prettier --write src",
        "format:eslint": "eslint --fix src",
        "format:stylelint": "stylelint --fix \"src/**/*.css\"",
        "lint": "npm-run-all lint:*",
        "lint:prettier": "prettier --check src",
        "lint:eslint": "eslint src",
        "lint:stylelint": "stylelint \"src/**/*.css\" || true",
        "lint:tsc": "tsc --noEmit --noUnusedLocals --noUnusedParameters --skipLibCheck",
        "start": "vite",
        "test": "vitest run",
        "test:coverage": "vitest --coverage",
        "test:watch": "vitest watch"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Rycochet/game.git"
    },
    "authors": [
        "Ryc O'Chet <rycochet@rycochet.com>"
    ],
    "bugs": {
        "url": "https://github.com/Rycochet/game/issues"
    },
    "homepage": "https://github.com/Rycochet/game",
    "devDependencies": {
        "@btmills/prettier": "3.2.5",
        "@ianvs/prettier-plugin-sort-imports": "4.2.1",
        "@small-tech/vite-plugin-sri": "1.0.1",
        "@testing-library/react": "15.0.2",
        "@types/node": "20.12.7",
        "@types/react": "18.2.79",
        "@types/react-dom": "18.2.25",
        "@vitejs/plugin-react": "4.2.1",
        "lightningcss": "1.24.1",
        "npm-run-all": "4.1.5",
        "tiny-invariant": "1.3.3",
        "typescript": "5.4.5",
        "vite": "5.4.6",
        "vite-plugin-compression2": "1.1.0",
        "vite-plugin-simple-html": "0.1.2",
        "vite-tsconfig-paths": "4.3.2",
        "vitest": "1.5.0"
    },
    "dependencies": {
        "@react-hookz/web": "24.0.4",
        "react": "18.2.0",
        "react-dom": "18.2.0"
    },
    "overrides": {
        "prettier": "npm:@btmills/prettier@3.2.4"
    }
}
