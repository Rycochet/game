{
    "name": "game",
    "version": "0.0.1",
    "description": "Proof of concept game",
    "scripts": {
        "build": "vite build",
        "build:preview": "vite preview",
        "clean": "rm -rf ./dist/**",
        "format": "npm-run-all format:*",
        "format:prettier": "prettier --write src",
        "lint": "npm-run-all lint:*",
        "lint:prettier": "prettier --check src",
        "lint:tsc": "tsc --noEmit --noUnusedLocals --noUnusedParameters --skipLibCheck",
        "start": "vite",
        "test": "vitest run",
        "test:coverage": "vitest --coverage",
        "test:watch": "vitest watch"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Rycochet/game.git"
    },
    "authors": [
        "Ryc O'Chet <rycochet@rycochet.com>"
    ],
    "bugs": {
        "url": "https://github.com/Rycochet/game/issues"
    },
    "homepage": "https://github.com/Rycochet/game",
    "dependencies": {
        "classnames": "2.5.1",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "simplex-noise": "4.0.3"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "@small-tech/vite-plugin-sri": "1.0.1",
        "@testing-library/react": "16.3.2",
        "@types/node": "25.2.3",
        "@types/react": "19.2.13",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "5.1.4",
        "assemblyscript": "0.28.9",
        "lightningcss": "1.31.1",
        "npm-run-all": "4.1.5",
        "prettier": "3.8.1",
        "sass-embedded": "1.97.3",
        "tiny-invariant": "1.3.3",
        "typescript": "5.9.3",
        "vite": "7.3.1",
        "vite-plugin-compression2": "2.4.0",
        "vite-plugin-simple-html": "1.1.0",
        "vite-tsconfig-paths": "6.1.0",
        "vitest": "4.0.18"
    }
}
