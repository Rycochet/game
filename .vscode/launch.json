{
    // F5 builds and runs the native game under the debugger (CodeLLDB extension).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug game",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=game", "--package=game"],
                "filter": {
                    "name": "game",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
